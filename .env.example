# PostgreSQL/PostGIS usado pelo Backend Tecsys
DB_NAME=postgres
DB_USER=preencha_localmente
DB_PASSWORD=preencha_localmente
DB_HOST=preencha_localmente
DB_PORT=5432
DB_SSLMODE=prefer
# DB_SSLROOTCERT=./global-bundle.pem

# Exportação manual do Spectrum-E (não a URL HTML da página)
# Abra: https://sistemas.anatel.gov.br/SE/public/view/b/licenciamento.php
# Em Licenciadas, use Download CSV e salve em data/anatel/emissoes_licenciadas.csv.
ANATEL_CSV_PATH=data/anatel/emissoes_licenciadas.csv
ANATEL_DATASET_LABEL=LICENCIADAS
# Para importar também a aba Cadastradas, salve a exportação como
# data/anatel/emissoes_cadastradas.csv e altere ANATEL_CSV_PATH e
# ANATEL_DATASET_LABEL=CADASTRADAS, execute de novo e depois restaure as variáveis.
# ANATEL_CSV_URL só deve ser usado se houver uma URL direta para o arquivo CSV/ZIP.
# ANATEL_CSV_URL=https://host.example/path/to/export.csv
